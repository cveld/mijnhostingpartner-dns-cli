{
  "name": "mijnhostingpartner-dns-cli",
  "version": "1.0.0",
  "description": "Manage MijnHostingPartner DNS records from the command line.",
  "license": "MIT",
  "author": "Carl in 't Veld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cveld/mijnhostingpartner-dns-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cveld/mijnhostingpartner-dns-cli/issues"
  },
  "homepage": "https://github.com/cveld/mijnhostingpartner-dns-cli#readme",
  "keywords": [
    "dns",
    "cli",
    "mijnhostingpartner",
    "playwright"
  ],
  "type": "module",
  "bin": {
    "mhp-dns": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "start": "tsx src/cli.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "playwright-core": "^1.55.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
