{
  "name": "mijnhostingpartner-dns-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Manage MijnHostingPartner DNS records from the command line.",
  "type": "module",
  "bin": { "mhp-dns": "dist/cli.js" },
  "scripts": {
